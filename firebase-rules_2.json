{
  "rules": {
    "posts": {
      ".read": "auth != null",
      ".indexOn": ["ts"],
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('authorId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['authorId', 'ts'])",
        "authorId": { ".validate": "newData.val() === auth.uid" },
        "caption": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "image": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "imagePath": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "ts": { ".validate": "newData.val() === now" },
        "likes": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "reports": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "comments": {
          "$cid": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'text', 'ts'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "ts": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.hasChild('name')",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "avatar": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "updatedAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "follows": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid",
        "$target": { ".validate": "newData.val() === true" }
      }
    },

    "conversations": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        "$other": {
          ".write": "auth != null && ($uid === auth.uid || $other === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    "messages": {
      "$convo": {
        ".read": "auth != null && ($convo.beginsWith(auth.uid + '__') || $convo.endsWith('__' + auth.uid))",
        ".indexOn": ["ts"],
        "$msgId": {
          ".write": "auth != null && !data.exists() && newData.exists() && ($convo.beginsWith(auth.uid + '__') || $convo.endsWith('__' + auth.uid))",
          ".validate": "newData.hasChildren(['sender', 'ts']) && newData.child('sender').val() === auth.uid",
          "sender": { ".validate": true },
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "media": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "ts": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
